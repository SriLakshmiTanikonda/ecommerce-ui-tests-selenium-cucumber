<?xml version="1.0" encoding="UTF-8"?>
<!-- Console shows INFO and above; the file keeps DEBUG for investigating failures.
     %X{scenario} is the scenario name, set per thread in Hooks, so parallel
     runs can be told apart in the log. -->
<Configuration status="WARN">
    <Properties>
        <Property name="pattern">%d{HH:mm:ss.SSS} %-5level [%t] [%X{scenario}] %c{1} - %msg%n</Property>
    </Properties>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${pattern}"/>
            <ThresholdFilter level="INFO"/>
        </Console>
        <File name="File" fileName="target/logs/test-run.log" append="false">
            <PatternLayout pattern="${pattern}"/>
        </File>
    </Appenders>
    <Loggers>
        <Logger name="com.qa.automation" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Logger>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>
